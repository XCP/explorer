# Cloudflare Workers Static Assets header rules. Everything under /_next/static is content-hashed (the
# filename changes whenever the bytes change), so it's safe — and correct — to cache it forever and skip the
# per-load revalidation the default (max-age=0, must-revalidate) forces.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/.well-known/*
  Access-Control-Allow-Origin: *

/.well-known/wallet-app.json
  Content-Type: application/json; charset=utf-8

/wallet-app/*
  Access-Control-Allow-Origin: *
