{
  "name": "xcpdex-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "test": "tsc -p tsconfig.test.json && node --test \".test-dist/tests/**/*.test.js\"",
    "test:contract": "tsc -p tsconfig.test.json && node tests/contract-runner.mjs",
    "deploy": "wrangler deploy && npm run test:contract",
    "migrate:local": "wrangler d1 migrations apply xcpio --local",
    "migrate:remote": "wrangler d1 migrations apply xcpio --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "prettier": "^3.9.4",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-sql": "^0.20.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@scure/btc-signer": "^2.2.0",
    "@xcp/shared": "*",
    "hono": "^4.12.28"
  }
}
