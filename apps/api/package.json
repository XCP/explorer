{
  "name": "xcp-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": {
      "types": "./src/*.ts",
      "node": "./.test-dist/src/*.js",
      "default": "./src/*.ts"
    },
    "#ops/*": {
      "types": "./ops/*.mjs",
      "node": "./.test-dist/ops/*.mjs",
      "default": "./ops/*.mjs"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node ops/check-sql-conventions.mjs && npm run test:migrations:recovery && node ops/clean-test-build.mjs && tsc -p tsconfig.test.json && node --test \".test-dist/tests/**/*.test.js\"",
    "test:migrations:recovery": "node ops/rehearse-recovery-migrations.mjs",
    "test:contract": "tsc -p tsconfig.test.json && node tests/contract-runner.mjs",
    "deploy": "wrangler deploy && npm run test:contract",
    "migrate:local": "wrangler d1 migrations apply xcpio --local",
    "migrate:remote": "wrangler d1 migrations apply xcpio --remote",
    "migrate:core:local": "wrangler d1 migrations apply xcpio-core --local",
    "migrate:core:remote": "wrangler d1 migrations apply xcpio-core --remote",
    "snapshot:core": "node ops/build-core-snapshot.mjs",
    "snapshot:core:status": "node ops/core-snapshot-status.mjs",
    "snapshot:core:import": "node ops/import-core-export.mjs",
    "build:core": "node ops/build-compact-core.mjs",
    "build:core:sql": "node ops/export-compact-core-sql.mjs",
    "build:core:sql:verify": "node ops/verify-compact-core-sql.mjs",
    "import:core:sql": "node ops/import-compact-core-sql.mjs",
    "migrate:recovery:local": "wrangler d1 migrations apply xcpio-btc --local",
    "migrate:recovery:remote": "wrangler d1 migrations apply xcpio-btc --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@xcp/shared": "*",
    "hono": "^4.12.28"
  }
}
