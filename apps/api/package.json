{
  "name": "xcp-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": {
      "types": "./src/*.ts",
      "node": "./.test-dist/src/*.js",
      "default": "./src/*.ts"
    },
    "#ops/*": {
      "types": "./ops/*.mjs",
      "node": "./.test-dist/ops/*.mjs",
      "default": "./ops/*.mjs"
    }
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "node ops/check-sql-conventions.mjs && npm run test:migrations:recovery && node ops/clean-test-build.mjs && tsc -p tsconfig.test.json && node --test \".test-dist/tests/**/*.test.js\"",
    "test:migrations:recovery": "node ops/rehearse-recovery-migrations.mjs",
    "test:contract": "tsc -p tsconfig.test.json && node tests/contract-runner.mjs",
    "evaluate:reputation": "node ops/evaluate-reputation-baselines.mjs",
    "review:asset-outlook": "node ops/review-asset-activity-outlook.mjs",
    "snapshot:reputation": "node ops/build-reputation-snapshot.mjs",
    "snapshot:radar-ownership": "node ops/build-radar-ownership.mjs",
    "snapshot:radar-block-times": "node ops/build-radar-block-times.mjs",
    "snapshot:radar-new-features": "node ops/build-radar-new-features.mjs",
    "validate:radar-ownership": "node ops/validate-radar-ownership.mjs",
    "snapshot:radar-issuances": "node ops/build-radar-issuance-history.mjs",
    "snapshot:radar-concentration": "node ops/build-radar-concentration.mjs",
    "snapshot:radar-trades": "node ops/build-radar-trade-history.mjs",
    "snapshot:radar-fairmints": "node ops/build-radar-fairmint-history.mjs",
    "evaluate:radar-concentration": "node ops/evaluate-radar-concentration.mjs",
    "snapshot:radar-holder-outcomes": "node ops/build-radar-holder-outcomes.mjs",
    "evaluate:radar-holder-outcomes": "node ops/evaluate-radar-holder-outcomes.mjs",
    "evaluate:radar-dislocations": "node ops/evaluate-radar-dislocations.mjs",
    "evaluate:radar-new": "node ops/evaluate-radar-new.mjs",
    "audit:radar-new-names": "node ops/audit-radar-new-names.mjs",
    "audit:current-dislocations": "node ops/audit-current-dislocations.mjs",
    "snapshot:current-dislocations": "node ops/snapshot-current-dislocations.mjs",
    "evaluate:graph-heldout": "node --max-old-space-size=2048 ops/evaluate-graph-heldout.mjs",
    "audit:tags": "node ops/audit-tags-collections.mjs",
    "audit:radar": "node ops/audit-radar-theses.mjs",
    "deploy": "wrangler deploy && npm run test:contract",
    "migrate:local": "wrangler d1 migrations apply xcpio-core --local",
    "migrate:remote": "wrangler d1 migrations apply xcpio-core --remote",
    "migrate:recovery:local": "wrangler d1 migrations apply xcpio-btc --local",
    "migrate:recovery:remote": "wrangler d1 migrations apply xcpio-btc --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@xcp/shared": "*",
    "hono": "^4.12.28"
  }
}
