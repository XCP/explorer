{
  "name": "xcp-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#api/*": {
      "types": "./src/*.ts",
      "node": "./.test-dist/src/*.js",
      "default": "./src/*.ts"
    },
    "#ops/*": {
      "types": "./ops/*.mjs",
      "node": "./.test-dist/ops/*.mjs",
      "default": "./ops/*.mjs"
    },
    "#ops/lib/*": {
      "types": "./ops/lib/*.mjs",
      "node": "./.test-dist/ops/lib/*.mjs",
      "default": "./ops/lib/*.mjs"
    }
  },
  "scripts": {
    "verify:counterparty-bitcoin-index": "node ops/verify-counterparty-bitcoin-index.mjs",
    "verify:electrs-index": "node ops/verify-electrs-index.mjs",
    "refresh:counterparty-bitcoin-sources": "node ops/refresh-counterparty-bitcoin-sources.mjs",
    "reconcile:counterparty-recovery": "node ops/reconcile-counterparty-recovery.mjs",
    "survey:ledger-otc-bitcoin": "node ops/survey-ledger-otc-bitcoin.mjs",
    "survey:ledger-otc-counterparty": "node ops/survey-ledger-otc-counterparty.mjs",
    "dev": "wrangler dev",
    "test": "node ops/check-sql-conventions.mjs && npm run test:migrations:recovery && node ops/clean-test-build.mjs && tsc -p tsconfig.test.json && node --test \".test-dist/tests/**/*.test.js\"",
    "test:migrations:recovery": "node ops/rehearse-recovery-migrations.mjs",
    "test:contract": "tsc -p tsconfig.test.json && node tests/contract-runner.mjs",
    "evaluate:reputation": "node ops/evaluate-reputation-baselines.mjs",
    "audit:address-reputation": "node ops/audit-address-reputation.mjs",
    "audit:asset-ratings": "node ops/audit-asset-ratings.mjs",
    "audit:usd-pricing": "node ops/audit-usd-pricing.mjs",
    "materialize:clean-usd-bridges": "node ops/materialize-clean-usd-bridges.mjs",
    "materialize:conservative-cmc-bridges": "node ops/materialize-conservative-cmc-bridges.mjs",
    "audit:xcp-price-disagreement": "node ops/audit-xcp-price-disagreement.mjs",
    "evaluate:xcp-price-cohorts": "node ops/evaluate-xcp-price-cohorts.mjs",
    "evaluate:xcp-volume-residual": "node ops/evaluate-xcp-volume-residual.mjs",
    "build:pepecash-price-candidates": "node ops/build-pepecash-price-candidates.mjs",
    "evaluate:pepecash-path-agreement": "node ops/evaluate-pepecash-path-agreement.mjs",
    "evaluate:pepecash-trade-census": "node ops/evaluate-pepecash-trade-census.mjs",
    "evaluate:pepecash-xcp-estimators": "node ops/evaluate-pepecash-xcp-estimators.mjs",
    "evaluate:pepecash-dispenser-prices": "node ops/evaluate-pepecash-dispenser-prices.mjs",
    "evaluate:pepecash-post2020-census": "node ops/evaluate-pepecash-post2020-census.mjs",
    "evaluate:pepecash-sparse-lanes": "node ops/evaluate-pepecash-sparse-lanes.mjs",
    "evaluate:pepecash-asset-history": "node ops/evaluate-pepecash-asset-history.mjs",
    "evaluate:usd-bridge-assets": "node ops/evaluate-usd-bridge-assets.mjs",
    "import:cmc-counterparty-history": "node ops/import-cmc-counterparty-history.mjs",
    "fetch:cmc-counterparty-snapshots": "node ops/fetch-cmc-counterparty-snapshots.mjs",
    "import:cmc-counterparty-snapshots": "node ops/import-cmc-counterparty-snapshots.mjs",
    "audit:market-coverage": "node ops/audit-counterparty-market-coverage.mjs",
    "evaluate:zaif-xcp": "node ops/evaluate-zaif-xcp-history.mjs",
    "snapshot:usd-pricing-baseline": "node ops/snapshot-usd-pricing-baseline.mjs",
    "import:zaif": "node ops/import-zaif-history.mjs",
    "import:ecb-fx": "node ops/import-ecb-fx-history.mjs",
    "import:cmc-xcp": "node ops/import-cmc-xcp-history.mjs",
    "import:cmc-xcp-csv": "node ops/import-cmc-xcp-csv.mjs",
    "import:cmc-btc-csv": "node ops/import-cmc-btc-csv.mjs",
    "review:asset-outlook": "node ops/review-asset-activity-outlook.mjs",
    "evaluate:asset-outlook-collections": "node ops/evaluate-asset-outlook-collections.mjs",
    "audit:asset-outlook": "node ops/audit-asset-activity-outlook.mjs",
    "snapshot:reputation": "node ops/build-reputation-snapshot.mjs",
    "snapshot:radar-ownership": "node ops/build-radar-ownership.mjs",
    "snapshot:radar-block-times": "node ops/build-radar-block-times.mjs",
    "snapshot:radar-new-features": "node ops/build-radar-new-features.mjs",
    "validate:radar-ownership": "node ops/validate-radar-ownership.mjs",
    "snapshot:radar-issuances": "node ops/build-radar-issuance-history.mjs",
    "snapshot:radar-concentration": "node ops/build-radar-concentration.mjs",
    "snapshot:radar-trades": "node ops/build-radar-trade-history.mjs",
    "snapshot:radar-fairmints": "node ops/build-radar-fairmint-history.mjs",
    "evaluate:radar-concentration": "node ops/evaluate-radar-concentration.mjs",
    "snapshot:radar-holder-outcomes": "node ops/build-radar-holder-outcomes.mjs",
    "evaluate:radar-holder-outcomes": "node ops/evaluate-radar-holder-outcomes.mjs",
    "evaluate:radar-dislocations": "node ops/evaluate-radar-dislocations.mjs",
    "evaluate:radar-new": "node ops/evaluate-radar-new.mjs",
    "audit:radar-new-names": "node ops/audit-radar-new-names.mjs",
    "audit:current-dislocations": "node ops/audit-current-dislocations.mjs",
    "snapshot:current-dislocations": "node ops/snapshot-current-dislocations.mjs",
    "evaluate:graph-heldout": "node --max-old-space-size=2048 ops/evaluate-graph-heldout.mjs",
    "audit:tags": "node ops/audit-tags-collections.mjs",
    "audit:radar": "node ops/audit-radar-theses.mjs",
    "deploy": "wrangler deploy && npm run test:contract",
    "migrate:local": "wrangler d1 migrations apply xcpio-core --local",
    "migrate:remote": "wrangler d1 migrations apply xcpio-core --remote",
    "migrate:recovery:local": "wrangler d1 migrations apply xcpio-btc --local",
    "migrate:recovery:remote": "wrangler d1 migrations apply xcpio-btc --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@scure/base": "^2.2.0",
    "@xcp/shared": "*",
    "hono": "^4.12.28"
  }
}
