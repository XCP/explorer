[Unit]
Description=XCP recovery Electrs reconciliation
After=network-online.target xcp-recovery-import.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/xcp-recovery-bootstrap.env
Environment=RECOVERY_FOLLOW_IMPORT=1
ExecStart=/usr/bin/node %h/.local/lib/xcp-recovery/reconcile-recovery.mjs
Restart=on-failure
RestartSec=15
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=default.target
