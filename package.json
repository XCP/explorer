{
  "name": "xcp-explorer",
  "private": true,
  "description": "XCP/explorer monorepo — apps/api = api.xcp.io (Cloudflare Worker API); apps/web = xcp.io (Next.js on OpenNext/Cloudflare).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w xcp-api",
    "dev:web": "npm run dev -w xcp-explorer-web",
    "test": "npm run test -w xcp-api",
    "test:contract": "npm run test:contract -w xcp-api",
    "bench:api": "node scripts/bench-api.mjs",
    "typecheck": "tsc -p packages/shared/tsconfig.json && tsc -p apps/api/tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"apps/**/*.{ts,tsx,mjs,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.{mjs,js}\" \".github/**/*.yml\" \"*.{json,mjs}\" \"docs/code-conventions.md\"",
    "format:check": "prettier --check \"apps/**/*.{ts,tsx,mjs,json}\" \"packages/**/*.{ts,json}\" \"scripts/**/*.{mjs,js}\" \".github/**/*.yml\" \"*.{json,mjs}\" \"docs/code-conventions.md\"",
    "check": "npm run typecheck && npm run lint && npm run format:check && node scripts/check-structure.mjs",
    "deploy:api": "npm run deploy -w xcp-api",
    "deploy:web": "npm run deploy -w xcp-explorer-web"
  },
  "devDependencies": {
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.4",
    "prettier-plugin-embed": "^0.5.1",
    "prettier-plugin-sql": "^0.20.0",
    "typescript-eslint": "^8.63.0"
  }
}
